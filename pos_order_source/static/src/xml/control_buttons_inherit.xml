<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_order_source.ControlButtonsInherit"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//t[@t-name='point_of_sale.ControlButtons']//button[1]" position="before">
            <t t-if="shouldShowOrderSourceButton()">
                <button
                    class="btn btn-warning"
                    t-on-click="onClickOrderSource"
                    t-att-style="isOrderSourceOnline() ? 'color: red; font-weight: bold; border: 2px solid red;' : ''"
                >
                    Online (
                    <t t-out="getOrderSourceLabel()"/>
                    )
                </button>
            </t>
        </xpath>

    </t>

</templates>