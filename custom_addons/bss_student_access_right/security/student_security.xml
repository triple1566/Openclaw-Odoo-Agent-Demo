<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="res_groups_privilege_bss_student" model="res.groups.privilege">
            <field name="name">BSS Student</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_student_user" model="res.groups">
            <field name="name">Student User</field>
            <field name="privilege_id" ref="res_groups_privilege_bss_student"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_student_admin" model="res.groups">
            <field name="name">Student Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_bss_student"/>
            <field name="implied_ids" eval="[(4, ref('group_student_user'))]"/>
        </record>

    </data>
</odoo>
