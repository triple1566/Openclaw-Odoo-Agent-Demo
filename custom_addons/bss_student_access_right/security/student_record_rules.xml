<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rule_bss_student_user_own_student" model="ir.rule">
            <field name="name">Student User Own Student</field>
            <field name="model_id" ref="bss_student.model_bss_student"/>
            <field name="groups" eval="[(4, ref('bss_student_access_right.group_student_user'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_bss_attendance_user_own_attendance" model="ir.rule">
            <field name="name">Student User Own Attendance</field>
            <field name="model_id" ref="bss_student.model_bss_attendance"/>
            <field name="groups" eval="[(4, ref('bss_student_access_right.group_student_user'))]"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_bss_student_admin_all_students" model="ir.rule">
            <field name="name">Student Admin All Students</field>
            <field name="model_id" ref="bss_student.model_bss_student"/>
            <field name="groups" eval="[(4, ref('bss_student_access_right.group_student_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_bss_attendance_admin_all_attendance" model="ir.rule">
            <field name="name">Student Admin All Attendance</field>
            <field name="model_id" ref="bss_student.model_bss_attendance"/>
            <field name="groups" eval="[(4, ref('bss_student_access_right.group_student_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
