<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_approval_configuration_tree" model="ir.ui.view">
        <field name="name">sale.approval.configuration.view.tree</field>
        <field name="model">sale.approval.configuration</field>
        <field name="arch" type="xml">
            <list string="Approval Configuration">
                <field name="sequence"/>
                <field name="user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sale_approval_configuration_form" model="ir.ui.view">
        <field name="name">sale.approval.configuration.view.form</field>
        <field name="model">sale.approval.configuration</field>
        <field name="arch" type="xml">
            <form string="Approval Configuration">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_approval_configuration" model="ir.actions.act_window">
        <field name="name">Approval Configuration</field>
        <field name="res_model">sale.approval.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
