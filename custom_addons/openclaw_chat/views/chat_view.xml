<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="chat_view_form" model="ir.ui.view">
        <field name="name">Create Session</field>
        <field name="model">claw.chat</field>
        <field name="arch" type="xml">
            <form string="Create new session">
                <sheet>
                    <group string="OpenClaw Specs">
                        <field name="creator" />
                        <field name="llm_model" />
                        <field name="hook_token" />
                        <field name="tailnet_addr" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="chat_view_list" model="ir.ui.view">
        <field name="name">OpenClaw Tunnels</field>
        <field name="model">claw.chat</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" />
                <field name="creator" />
                <field name="llm_model" />
                <field name="hook_token" />
                <field name="tailnet_addr" />
            </list>
        </field>
    </record>

    <record id="chat_view_action" model="ir.actions.act_window">
        <field name="name">Openclaw View</field>
        <field name="res_model">claw.chat</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
