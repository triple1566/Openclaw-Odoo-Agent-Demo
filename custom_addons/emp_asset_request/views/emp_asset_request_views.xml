<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_emp_asset_request_list" model="ir.ui.view">
            <field name="name">emp.asset.request.list</field>
            <field name="model">emp.asset.request</field>
            <field name="arch" type="xml">
                <list string="Asset Requests">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="manager_id"/>
                    <field name="asset_model_id"/>
                    <field name="quantity"/>
                    <field name="state"/>
                    <field name="assignment_date"/>
                </list>
            </field>
        </record>

        <record id="view_emp_asset_request_form" model="ir.ui.view">
            <field name="name">emp.asset.request.form</field>
            <field name="model">emp.asset.request</field>
            <field name="arch" type="xml">
                <form string="Asset Request">
                    <header>
                        <button name="action_submit"
                                string="Submit"
                                type="object"
                                class="btn-primary"
                            invisible="state != 'draft'"/>
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                            invisible="state != 'submitted' or not is_current_manager"/>
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-secondary"
                            invisible="state != 'submitted' or not is_current_manager"/>
                        <button name="action_open_assignment_wizard"
                                string="Assign Assets"
                                type="object"
                                class="btn-primary"
                            invisible="state != 'approved' or not is_current_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,assigned"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="manager_id" readonly="1"/>
                                <field name="is_current_manager" invisible="1"/>
                            </group>
                            <group>
                                <field name="asset_model_id" readonly="state != 'draft'"/>
                                <field name="quantity" readonly="state != 'draft'"/>
                                <field name="assignment_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Reason">
                                <field name="reason" readonly="state != 'draft'"/>
                            </page>
                            <page string="Assigned Assets">
                                <field name="assigned_asset_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_emp_asset_request_search" model="ir.ui.view">
            <field name="name">emp.asset.request.search</field>
            <field name="model">emp.asset.request</field>
            <field name="arch" type="xml">
                <search string="Asset Requests">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="manager_id"/>
                    <field name="asset_model_id"/>
                    <field name="state"/>
                    <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Group by Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Group by Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Group by Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Group by Asset Type" name="group_asset_type" context="{'group_by': 'asset_model_id'}"/>
                </search>
            </field>
        </record>

        <record id="view_emp_asset_request_pivot" model="ir.ui.view">
            <field name="name">emp.asset.request.pivot</field>
            <field name="model">emp.asset.request</field>
            <field name="arch" type="xml">
                <pivot string="Asset Request Analysis" sample="1">
                    <field name="employee_id" type="row"/>
                    <field name="manager_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="quantity" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="action_emp_asset_request" model="ir.actions.act_window">
            <field name="name">Asset Requests</field>
            <field name="res_model">emp.asset.request</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="search_view_id" ref="view_emp_asset_request_search"/>
        </record>

        <record id="view_emp_asset_request_report_list" model="ir.ui.view">
            <field name="name">emp.asset.request.report.list</field>
            <field name="model">emp.asset.request</field>
            <field name="arch" type="xml">
                <list string="Asset Request Report" create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="manager_id"/>
                    <field name="asset_model_id"/>
                    <field name="quantity"/>
                    <field name="state"/>
                    <field name="assignment_date"/>
                </list>
            </field>
        </record>

        <record id="action_emp_asset_request_report" model="ir.actions.act_window">
            <field name="name">Asset Request Reports</field>
            <field name="res_model">emp.asset.request</field>
            <field name="view_mode">list,pivot</field>
            <field name="search_view_id" ref="view_emp_asset_request_search"/>
            <field name="view_id" ref="view_emp_asset_request_report_list"/>
            <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
        </record>

        <menuitem id="menu_emp_asset_request_root"
                  name="Asset Requests"
                  sequence="95"/>

        <menuitem id="menu_emp_asset_request"
                  name="Requests"
                  parent="menu_emp_asset_request_root"
                  action="action_emp_asset_request"
                  sequence="10"/>

        <menuitem id="menu_emp_asset_request_report"
                  name="Reports"
                  parent="menu_emp_asset_request_root"
                  action="action_emp_asset_request_report"
                  sequence="20"/>
    </data>
</odoo>
