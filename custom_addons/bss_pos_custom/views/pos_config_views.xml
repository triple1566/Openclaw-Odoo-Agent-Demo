<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_inherit_show_order" model="ir.ui.view">
        <field name="name">pos.config.inherit.show.order.button</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='is_restaurant']" position="after">
                <setting id="show_order_button_setting" string="Show Order Button" help="Enable showing the order button in POS.">
                    <field name="pos_show_order_button"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
