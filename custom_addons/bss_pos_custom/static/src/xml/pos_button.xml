<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="bss_pos_custom.ProductScreenExtension"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'control-buttons')]" position="inside">
            <button class="control-button"
            t-if="showOnlineButton()"
            t-att-style="getOnlineButtonStyle()"
            t-on-click="onClickOnlineButton">
                Online
            </button>
        </xpath>

        <xpath expr="//div[contains(@class, 'product-screen')]" position="before">
            <div class="bss-order-source-title px-2 py-1 border-bottom bg-light">
                <span t-out="getOrderTopLabel()"/>
            </div>
        </xpath>
    </t>

</templates>