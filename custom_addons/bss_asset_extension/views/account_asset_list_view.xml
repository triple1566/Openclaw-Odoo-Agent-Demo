<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_asset_tree_inherit_bss_asset_extension" model="ir.ui.view">
            <field name="name">account.asset.list.inherit.bss.asset.extension</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='name']" position="after">
                    <field name="depreciation_date" optional="show"/>
                    <field name="depreciation_countdown" optional="show"/>
                    <field name="alerted" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
