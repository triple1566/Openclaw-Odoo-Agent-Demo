<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bss_asset_transfer_wizard_form" model="ir.ui.view">
            <field name="name">bss.asset.transfer.wizard.form</field>
            <field name="model">bss.asset.transfer.wizard</field>
            <field name="arch" type="xml">
                <form string="Transfer Asset">
                    <sheet>
                        <group>
                            <field name="asset_id"/>
                            <field name="from_branch" readonly="1"/>
                            <field name="to_branch"/>
                            <field name="transfer_account_id"/>
                            <field name="transfer_date"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_transfer" type="object" string="Transfer" class="oe_highlight"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>