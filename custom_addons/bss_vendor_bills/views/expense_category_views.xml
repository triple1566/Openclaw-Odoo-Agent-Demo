<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bss_expense_category_tree" model="ir.ui.view">
            <field name="name">bss.expense.category.tree</field>
            <field name="model">bss.expense.category</field>
            <field name="arch" type="xml">
                <list string="Expense Categories">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_bss_expense_category_form" model="ir.ui.view">
            <field name="name">bss.expense.category.form</field>
            <field name="model">bss.expense.category</field>
            <field name="arch" type="xml">
                <form string="Expense Category">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bss_expense_category" model="ir.actions.act_window">
            <field name="name">Expense Categories</field>
            <field name="res_model">bss.expense.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_bss_expense_category_root" name="Expense Categories" parent="account.menu_finance_configuration" action="action_bss_expense_category" sequence="90"/>
    </data>
</odoo>
