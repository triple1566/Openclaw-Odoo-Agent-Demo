<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="account_reports.AccountReportFiltersCustomizable" t-inherit-mode="extension">
        <xpath expr="//t[@t-if=&quot;'partner' in controller.cachedFilterOptions&quot;]" position="after">
            <t t-if="'expense_category_ids' in controller.cachedFilterOptions">
                <div id="filter_expense_category">
                    <t t-call="bss_vendor_bills.AccountReportFilterExpenseCategory"/>
                </div>
            </t>
        </xpath>
    </t>

    <t t-name="bss_vendor_bills.AccountReportFilterExpenseCategory">
        <Dropdown menuClass="'account_report_filter expense_category'">
            <button class="btn btn-secondary">
                <i class="fa fa-tags me-1"/>Expense Categories
            </button>
            <t t-set-slot="content">
                <div class="dropdown-item gap-2 align-items-center">
                    <label>Expense Categories</label>
                    <MultiRecordSelector t-props="getMultiRecordSelectorProps('bss.expense.category', 'expense_category_ids')"/>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
