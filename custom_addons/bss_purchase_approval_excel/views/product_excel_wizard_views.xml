<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_excel_import_wizard_form" model="ir.ui.view">
        <field name="name">product.excel.import.wizard.form</field>
        <field name="model">product.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Products From Excel">
                <group>
                    <field name="file_name"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <footer>
                    <button name="action_import_products" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_excel_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Products (Excel)</field>
        <field name="res_model">product.excel.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_product_excel_export_wizard_form" model="ir.ui.view">
        <field name="name">product.excel.export.wizard.form</field>
        <field name="model">product.excel.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Products To Excel">
                <group>
                    <field name="include_archived"/>
                </group>
                <footer>
                    <button name="action_export_products" type="object" string="Export" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_excel_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Products (Excel)</field>
        <field name="res_model">product.excel.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
