<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_export_template" model="ir.ui.view">
        <field name="name">product.template.tree.export.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_import_product_template"
                        type="object"
                        string="Import Products"
                        class="btn-primary"
                        groups="purchase.group_purchase_manager"
                    />
                    <button
                        name="action_export_product_template"
                        type="object"
                        string="Export Products"
                        class="btn-secondary"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_uom_po" model="ir.ui.view">
        <field name="name">product.template.form.uom.po</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="uom_po_id" />
            </xpath>
        </field>
    </record>
</odoo>
