<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_export_template" model="ir.ui.view">
        <field name="name">product.template.tree.export.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_export_product_template"
                        type="object"
                        string="Export Template"
                        class="btn-secondary"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
