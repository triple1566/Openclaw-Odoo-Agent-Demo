<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_approval_configuration_tree" model="ir.ui.view">
        <field name="name">purchase.approval.configuration.tree</field>
        <field name="model">approval.configuration</field>
        <field name="arch" type="xml">
            <list string="Approval Configuration">
                <field name="amount_from"/>
                <field name="amount_to"/>
                <field name="approval_role"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_approval_configuration_form" model="ir.ui.view">
        <field name="name">purchase.approval.configuration.form</field>
        <field name="model">approval.configuration</field>
        <field name="arch" type="xml">
            <form string="Approval Configuration">
                <sheet>
                    <group>
                        <field name="amount_from"/>
                        <field name="amount_to"/>
                        <field name="approval_role"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_approval_configuration" model="ir.actions.act_window">
        <field name="name">Approval Configuration</field>
        <field name="res_model">approval.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
