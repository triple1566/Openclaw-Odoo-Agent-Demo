<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_role_assignment_tree" model="ir.ui.view">
        <field name="name">approval.role.assignment.tree</field>
        <field name="model">approval.role.assignment</field>
        <field name="arch" type="xml">
            <list string="Approval Role Assignments">
                <field name="user_id"/>
                <field name="approval_role"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_approval_role_assignment_form" model="ir.ui.view">
        <field name="name">approval.role.assignment.form</field>
        <field name="model">approval.role.assignment</field>
        <field name="arch" type="xml">
            <form string="Approval Role Assignment">
                <sheet>
                    <group>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="approval_role"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_role_assignment" model="ir.actions.act_window">
        <field name="name">Approval Role Assignments</field>
        <field name="res_model">approval.role.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>