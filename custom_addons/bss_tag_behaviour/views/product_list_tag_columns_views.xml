<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_list_view_add_tag_column" model="ir.ui.view">
        <field name="name">product.template.list.add.tag.column</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_view_tree_tag"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="product_tag_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_variant_list_view_add_variant_tag_column" model="ir.ui.view">
        <field name="name">product.product.list.add.variant.tag.column</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_view_tree_tag"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="additional_product_tag_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>