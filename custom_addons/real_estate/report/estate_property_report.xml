<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_estate_property" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate.report_estate_property_document</field>
        <field name="report_file">real_estate.report_estate_property_document</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_estate_property_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="o.name"/>
                        </h2>

                        <div t-if="o.state == 'sold'" style="color: red; font-size: 24px; font-weight: bold; margin-bottom: 10px;">
                            SOLD
                        </div>

                        <table class="table table-sm table-striped" style="width: 100%; margin-bottom: 16px;">
                            <thead>
                                <tr>
                                    <th>Expected Price</th>
                                    <th>Selling Price</th>
                                    <th>State</th>
                                    <th>Buyer</th>
                                    <th>Seller</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.expected_price"/></td>
                                    <td><span t-field="o.selling_price"/></td>
                                    <td><span t-field="o.state"/></td>
                                    <td><span t-field="o.buyer"/></td>
                                    <td><span t-field="o.seller"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Offers</h3>
                        <table class="table table-sm table-bordered" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Partner</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Deadline</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.offer_ids" t-as="offer">
                                    <td><span t-field="offer.partner_id"/></td>
                                    <td><span t-field="offer.price"/></td>
                                    <td><span t-field="offer.status"/></td>
                                    <td><span t-field="offer.date_deadline"/></td>
                                </tr>
                                <tr t-if="not o.offer_ids">
                                    <td colspan="4">No offers received.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
