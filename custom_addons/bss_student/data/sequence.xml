<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Student Number Sequence -->
        <record id="seq_bss_student" model="ir.sequence">
            <field name="name">Student Number</field>
            <field name="code">bss.student</field>
            <field name="prefix">STD/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Attendance Number Sequence -->
        <record id="seq_bss_attendance" model="ir.sequence">
            <field name="name">Attendance Number</field>
            <field name="code">bss.attendance</field>
            <field name="prefix">ATD/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

    </data>
</odoo>
