<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_users_form_inherit_bss_student_partner_edit" model="ir.ui.view">
            <field name="name">res.users.form.inherit.bss.student.partner.edit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id' and @groups='base.group_no_one']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                    <attribute name="readonly">0</attribute>
                    <attribute name="domain">[('is_student', '=', True)]</attribute>
                    <attribute name="options">{'no_create': True}</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
