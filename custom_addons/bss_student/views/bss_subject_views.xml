<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Subject List View -->
        <record id="view_bss_subject_tree" model="ir.ui.view">
            <field name="name">bss.subject.tree</field>
            <field name="model">bss.subject</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Subject Form View -->
        <record id="view_bss_subject_form" model="ir.ui.view">
            <field name="name">bss.subject.form</field>
            <field name="model">bss.subject</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Subject Action -->
        <record id="action_bss_subject" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">bss.subject</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Subject
                </p>
            </field>
        </record>

    </data>
</odoo>
