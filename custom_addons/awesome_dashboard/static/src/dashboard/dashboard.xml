<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        Exercise 1: Layout wraps everything in Odoo's standard control-panel
        + content-area structure.
        Exercise 2: Customers / Leads / Settings buttons in the control panel.
        Exercises 9–11: Dynamic item rendering via t-foreach over the registry.
    -->
    <t t-name="awesome_dashboard.Dashboard">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100'">

            <!-- Exercise 2: control-panel buttons -->
            <t t-set-slot="control-panel-top-right">
                <button class="btn btn-primary me-2" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary me-2" t-on-click="openLeads">
                    Leads
                </button>
                <!-- Exercise 11: gear / settings button -->
                <button class="btn btn-secondary" t-on-click="openSettings"
                        title="Configure dashboard">
                    <i class="fa fa-cog"/>
                </button>
            </t>

            <!-- Main content area -->
            <div class="d-flex flex-wrap align-items-start p-3">
                <!--
                    Exercise 9 / 10: Iterate over registry items.
                    Dynamic component + dynamic props (advanced Owl features).
                -->
                <t t-foreach="visibleItems" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProps"
                           t-value="item.props ? item.props(statistics) : { data: statistics }"/>
                        <t t-component="item.Component" t-props="itemProps"/>
                    </DashboardItem>
                </t>
            </div>

        </Layout>
    </t>

</templates>
