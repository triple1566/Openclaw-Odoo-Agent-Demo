<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        Exercise 11: Configuration dialog.
        Lists every registered dashboard item with a checkbox.
        Users uncheck items they want to hide; Apply saves to localStorage.
    -->
    <t t-name="awesome_dashboard.ConfigurationDialog">
        <Dialog title="'Dashboard Configuration'">

            <div class="mb-3">
                <t t-foreach="props.items" t-as="item" t-key="item.id">
                    <div class="form-check mb-2">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            t-att-id="'dashitem_' + item.id"
                            t-att-checked="isVisible(item.id)"
                            t-on-change="() => toggleItem(item.id)"
                        />
                        <label class="form-check-label"
                               t-att-for="'dashitem_' + item.id">
                            <t t-esc="item.description"/>
                        </label>
                    </div>
                </t>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="apply">Apply</button>
                <button class="btn btn-secondary ms-2" t-on-click="props.close">
                    Cancel
                </button>
            </t>

        </Dialog>
    </t>

</templates>
