<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Exercise 7 / 9 / 10: TodoList template -->
    <t t-name="awesome_owl.TodoList">
        <div class="todo-list">
            <!-- Exercise 9: input to add todos; Exercise 10: t-ref for autofocus -->
            <input
                t-ref="input"
                class="form-control mb-3"
                placeholder="Enter a new task"
                t-on-keyup="addTodo"
            />
            <div>
                <!-- Exercise 7: render each todo via TodoItem -->
                <t t-foreach="todos" t-as="todo" t-key="todo.id">
                    <TodoItem
                        todo="todo"
                        toggleState.bind="toggleState"
                        removeTodo.bind="removeTodo"
                    />
                </t>
            </div>
        </div>
    </t>

    <!-- Exercise 7 / 8 / 11 / 12: TodoItem template -->
    <t t-name="awesome_owl.TodoItem">
        <!-- Exercise 8: dynamic class for completed todos -->
        <div class="d-flex align-items-center gap-2 mb-1"
             t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
            <!-- Exercise 11: checkbox to toggle completion -->
            <input
                type="checkbox"
                t-att-checked="props.todo.isCompleted"
                t-on-change="onToggle"
            />
            <span>
                <t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/>
            </span>
            <!-- Exercise 12: remove icon -->
            <span class="fa fa-remove text-danger" style="cursor:pointer;" t-on-click="onRemove"/>
        </div>
    </t>

</templates>
