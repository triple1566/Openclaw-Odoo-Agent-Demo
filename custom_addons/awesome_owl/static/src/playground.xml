<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="container mt-4">

            <!-- Exercise 2 / 6: two Counter sub-components with sum tracking -->
            <h2>Counters</h2>
            <Counter onChange.bind="incrementSum"/>
            <Counter onChange.bind="incrementSum"/>
            <p class="mt-2">Sum: <t t-esc="state.sum"/></p>

            <!-- Exercise 13 / 14: Cards using slots; body is minimizable -->
            <h2 class="mt-4">Cards</h2>
            <!-- Card with a Counter inside (exercise 13) -->
            <Card title="'A Counter'">
                <Counter/>
            </Card>
            <!-- Card demonstrating markup vs escaped strings (exercise 4) -->
            <Card title="'Markup Demo'">
                <p>Escaped: <t t-esc="rawHtml"/></p>
                <p>Safe HTML: <t t-out="html"/></p>
            </Card>

            <!-- Exercise 7–12: Todo list -->
            <h2 class="mt-4">Todo List</h2>
            <TodoList/>

        </div>
    </t>

</templates>
